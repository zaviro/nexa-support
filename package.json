{
  "name": "nexa-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "agents:restore": "skills experimental_install",
    "build": "next build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "dev": "next dev --turbo",
    "hooks:check": "lefthook check-install",
    "hooks:install": "lefthook install",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; fi",
    "preview": "next build && next start",
    "quality": "bun run check && bun run typecheck && bun run test:unit && bun run build && bun run test:e2e",
    "start": "next start",
    "test": "bun run test:unit",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test --ui",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.12.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.2.5",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "postcss": "^8.5.3",
    "skills": "^1.5.20",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "vercel": "^57.0.0",
    "vitest": "^4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
